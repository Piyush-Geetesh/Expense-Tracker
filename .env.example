# Local Django settings. Copy to .env; existing environment variables win.
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-development-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_TRUST_PROXY=False
# Keep local development on SQLite unless intentionally using a separate Neon branch.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

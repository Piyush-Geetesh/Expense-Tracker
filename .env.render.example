# Reference for Render's Environment page, not an automatically loaded file.
# Copy the real Neon URL directly into Render; do not commit it.
DEBUG=False
DJANGO_READ_DOTENV=False
DJANGO_SECRET_KEY=REPLACE_WITH_A_GENERATED_RANDOM_SECRET
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
DJANGO_CSRF_TRUSTED_ORIGINS=https://expense-tracker-lemon-omega-49.vercel.app
DJANGO_TRUST_PROXY=True
RUN_MIGRATIONS=False
WEB_CONCURRENCY=2
# Render automatically supplies RENDER_EXTERNAL_HOSTNAME, which Django allows.
# DJANGO_ALLOWED_HOSTS=your-custom-api-domain.example
